# Uploaded payment receipts only - never execute scripts from this folder.
# Proof-of-payment accepts almost any file type, so this is the backstop
# that keeps an uploaded file from ever running as code even if a
# disallowed extension somehow made it onto disk.
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>

<FilesMatch "\.(php|phtml|php\d|pl|py|cgi|sh|asp|aspx|exe|com|bat|cmd|jar)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
